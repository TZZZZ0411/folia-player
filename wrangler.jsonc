{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "folia",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-02",
  "compatibility_flags": [
    "assets_navigation_prefers_asset_serving",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "folia.tidlock.online",
      "zone_name": "tidlock.online",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QQ_RELAY",
        "class_name": "QqQrChannel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QqQrChannel"
      ]
    }
  ]
}
