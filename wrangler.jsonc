{
  "name": "folia",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-02",
  "compatibility_flags": [
    "assets_navigation_prefers_asset_serving",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QQ_RELAY",
        "class_name": "QqRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QqRelay"]
    }
  ],
  "vars": {
    "QQ_SESSION_SECRET": "4tdrgfhtyjbzsdgyjhbdffyujgbgj"
  }
}
